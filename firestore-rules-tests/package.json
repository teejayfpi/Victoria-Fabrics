{
  "name": "victoria-fabrics-rules-tests",
  "private": true,
  "type": "commonjs",
  "version": "1.0.0",
  "description": "Firestore/Storage security-rules regression tests (emulator-backed).",
  "scripts": {
    "test": "npm run test:firestore && npm run test:storage",
    "test:firestore": "firebase emulators:exec --only firestore --project victoria-fabrics \"node firestore.rules.test.js\"",
    "test:storage": "firebase emulators:exec --only storage --project victoria-fabrics \"node storage.rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
