rules_version = '2';

// Victoria Fabrics — Firestore security rules.
//
// Guiding principles:
//   * Deny by default. Every collection is explicitly allow-listed.
//   * Admin privileges are read from the `admins/{uid}` document OR a
//     `role` custom claim — never trusted from the client.
//   * Customers may read the catalogue but may never write products.
//   * Orders are created server-side through a transaction; the client can
//     only read its own orders.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's `role` custom claim, or '' when the token carries no such
    // claim.
    //
    // Read via `token.get(...)` rather than `request.auth.token.role`: indexing
    // a *missing* key off the token throws in the rules engine ("Property role
    // is undefined on object"). That aborts the whole boolean before the
    // `admins/{uid}` roster fallback below is ever evaluated, so an admin
    // provisioned through the roster document was denied every order/ticket
    // read and every catalogue write. `get` returns the default instead.
    function tokenRole() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    // Whether the token carries a `role` claim at all. A claim is authoritative
    // when present; when absent we defer to the roster document.
    function hasRoleClaim() {
      return isSignedIn() && request.auth.token.keys().hasAny(['role']);
    }

    // Role document lookup; used as a fallback when no custom claim is set.
    function hasAdminDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The `role` field of the caller's roster document, or '' when there is no
    // document (or the document has no `role` field). Reading the *value* (not
    // just the document's existence) matters: a `viewer` roster entry must not
    // be treated as staff, or a read-only account could edit the catalogue.
    //
    // `data.get('role', '')` rather than `data.role`: the latter throws on a
    // document that lacks the field, and both the '' default and `get` keep the
    // expression error-free so a denial is a plain "false" rather than a rules
    // evaluation error.
    function adminDocRole() {
      return hasAdminDoc()
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function isAdmin() {
      return isSignedIn()
        && (tokenRole() in ['admin', 'superAdmin', 'super_admin']
            || (!hasRoleClaim()
                && adminDocRole() in ['admin', 'superAdmin', 'super_admin']));
    }

    function isStaff() {
      return isSignedIn()
        && (tokenRole() in ['staff', 'admin', 'superAdmin', 'super_admin']
            || (!hasRoleClaim()
                && adminDocRole() in ['staff', 'admin', 'superAdmin', 'super_admin']));
    }

    // ─── Order integrity helpers ────────────────────────────────────────
    // Rules cannot loop, so line validation is unrolled. Each line costs one
    // get(), and the engine allows 10 per request (cached repeats are free),
    // hence the 10-item ceiling.

    function unitPriceFor(product, unit) {
      return unit == 'Yard'
          ? product.pricePerYard
          : unit == 'Meter'
              ? product.pricePerMeter
              : product.pricePerPiece;
    }

    // A line is valid only if its price and line total match the authoritative
    // product document. This is what stops a client dictating its own price.
    function lineMatchesProduct(line) {
      return line.quantity is int
        && line.quantity > 0
        && line.quantity <= 1000
        && line.selectedUnit in ['Yard', 'Meter', 'Piece']
        && line.unitPrice is number
        && line.unitPrice > 0
        && line.unitPrice == unitPriceFor(
             get(/databases/$(database)/documents/products/$(line.productId)).data,
             line.selectedUnit)
        && line.totalPrice is number
        && line.totalPrice == line.unitPrice * line.quantity;
    }

    function orderLinesValid(items) {
      return items.size() >= 1
        && items.size() <= 10
        && lineMatchesProduct(items[0])
        && (items.size() <= 1 || lineMatchesProduct(items[1]))
        && (items.size() <= 2 || lineMatchesProduct(items[2]))
        && (items.size() <= 3 || lineMatchesProduct(items[3]))
        && (items.size() <= 4 || lineMatchesProduct(items[4]))
        && (items.size() <= 5 || lineMatchesProduct(items[5]))
        && (items.size() <= 6 || lineMatchesProduct(items[6]))
        && (items.size() <= 7 || lineMatchesProduct(items[7]))
        && (items.size() <= 8 || lineMatchesProduct(items[8]))
        && (items.size() <= 9 || lineMatchesProduct(items[9]));
    }

    // Allowed status transitions. The admin app exposes one forward step at a
    // time; the rules enforce the same graph so a client cannot skip states or
    // resurrect a cancelled order. `ready` and `cancelled` are terminal-ish:
    // `ready` may only go to `delivered`, `cancelled` to nothing.
    function statusTransitionValid(from, to) {
      return (from == 'pending' && to in ['confirmed', 'cancelled'])
        || (from == 'confirmed' && to in ['preparing', 'cancelled'])
        || (from == 'preparing' && to in ['ready', 'delivered', 'cancelled'])
        || (from == 'ready' && to in ['delivered'])
        || (from == 'delivered' && to in ['cancelled']);
    }

    // The client may not choose its own status, backdate the order, or place it
    // on behalf of another account.
    function orderShapeValid() {
      // Field allow-list, size caps and a total ceiling keep a client on the
      // transaction fallback from padding an order document with junk fields
      // or absurd values. Prices themselves are still derived by the rules.
      return request.resource.data.keys().hasOnly([
               'id', 'userId', 'items', 'totalAmount', 'deliveryType',
               'deliveryAddress', 'pickupLocation', 'status', 'createdAt',
               'customerName', 'customerPhone',
             ])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.deliveryType in ['delivery', 'pickup']
        && request.resource.data.id is string
        && request.resource.data.id.size() == 8
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 10
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.totalAmount < 100000000
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 200
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() <= 30;
    }

    // ─── Products ───────────────────────────────────────────────────────
    // Public catalogue. Staff may edit anything. A signed-in customer placing
    // an order through the transaction fallback may only *decrease* the stock
    // counters — never price, name, or availability-inflating values. (The
    // `placeOrder` function path uses the Admin SDK and bypasses this.)
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['stockCount', 'inStock'])
            && request.resource.data.stockCount is int
            && resource.data.stockCount is int
            && request.resource.data.stockCount < resource.data.stockCount);
    }

    // ─── Categories ─────────────────────────────────────────────────────
    // Public catalogue; only staff may manage categories.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── Seed markers ───────────────────────────────────────────────────
    // Idempotency guards for first-run catalogue seeding. Write-once, and only
    // by staff: the marker must not be claimable by an anonymous client, or a
    // stranger could poison it and permanently block the real seed.
    match /_meta/{docId} {
      allow read: if true;
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ─── Admins ─────────────────────────────────────────────────────────
    // Only an existing admin may read the roster. Role assignment stays
    // server-side so the client can never self-promote.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // An administrator may edit their own profile fields. `role` is
      // deliberately excluded: allowing it here would let any staff account
      // promote itself to super admin, so role changes remain a server-side
      // (Admin SDK) operation.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'email']);

      allow create, delete: if false;
    }

    // ─── Store settings ─────────────────────────────────────────────────
    // Owner-editable, world-readable: the storefront must show the delivery
    // fee and shop address before sign-in, and the document holds no secrets.
    // Only staff may change it.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── Orders ─────────────────────────────────────────────────────────
    // Two creation paths, both integrity-checked server-side:
    //   * the `placeOrder` Cloud Function (Admin SDK writes bypass these
    //     rules), and
    //   * the client transaction used when functions are unavailable (free
    //     Spark plan). That path is validated here: every line price must
    //     match the authoritative product document, the status must be
    //     `pending`, the timestamp must be the server time, and the order must
    //     belong to the caller.
    // Staff may advance status; nobody may rewrite or delete an order.
    match /orders/{orderId} {
      // Staff see everything; a signed-in customer sees only their orders.
      allow read: if isStaff()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && orderShapeValid()
        && orderLinesValid(request.resource.data.items);

      // Staff may advance the status (the admin app's Confirm / Start
      // Preparing / Mark Delivered buttons) and nothing else: every other
      // field must be unchanged, and the transition must move forward one
      // step. Cancelling is allowed from any non-terminal state. Nobody may
      // rewrite prices, items or totals, and nobody may delete an order.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])
        && statusTransitionValid(resource.data.status,
             request.resource.data.status);

      allow delete: if false;
    }

    // ─── Support tickets ────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Anyone (including guests) may open a ticket, but the payload is
      // validated and cannot pre-set an administrative status.
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
             'customerName', 'customerPhone', 'subject', 'message',
             'status', 'createdAt', 'userId',
           ]);

      allow update, delete: if isStaff();
    }

    // ─── Users ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ─── Deny everything else ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
